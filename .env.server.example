# Copy to .env.server on the server and fill in.
# Start with: docker compose --env-file .env.server -f docker-compose.server.yml up -d --build

NODE_ENV=production
PORT=3000

# Domain that points to this server, without https:// or www.
# The app opens at https://DOMAIN and the API at https://api.DOMAIN.
DOMAIN=localhost
# Address of the app, used in the "esqueci minha senha" link: https:// + DOMAIN
APP_URL=https://localhost

# MySQL (created on the first start; DB_HOST and DB_PORT come from the compose file)
DB_HOST=db
DB_PORT=3306
DB_NAME=tpf
DB_DATABASE=tpf
DB_USER=tpf
DB_PASSWORD=troque-esta-senha
DB_ROOT_PASSWORD=troque-esta-senha-root

# Long random text, different on each environment: openssl rand -hex 32
JWT_SECRET=troque-isto
JWT_EXPIRATION=7d

# "Esqueci minha senha" e-mail, sent through Resend (resend.com, free plan).
# Without a key the reset link is not sent. The sender's domain must be
# verified in Resend.
RESEND_API_KEY=
MAIL_FROM=Trampo Fácil <nao-responda@app-trampofacil.com.br>

# Inbox that receives the messages people send from the app's "Ajuda e suporte"
# screen (also sent through Resend, with the person's e-mail as reply-to).
# Without it the support form answers that it could not send.
SUPPORT_EMAIL=
