# Caddy gets and renews the HTTPS certificates by itself.
# With DOMAIN=localhost it uses local certificates (for testing on your PC).

# The app's web version (built from ../tpf-app, files in /srv).
{$DOMAIN} {
	encode gzip
	root * /srv
	# The app uses browser history routes such as /privacidade.
	try_files {path} /index.html
	file_server
}

api.{$DOMAIN} {
	encode gzip
	reverse_proxy api:3000
}
